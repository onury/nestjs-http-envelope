{
  "name": "nestjs-http-envelope",
  "version": "1.0.1",
  "description": "A uniform response & error envelope for NestJS — success/error interceptor + all-exceptions filter, attribute-hoisting (pagination), and @SkipEnvelope, all configurable.",
  "type": "module",
  "license": "MIT",
  "author": "Onur Yıldırım",
  "homepage": "https://github.com/onury/nestjs-http-envelope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onury/nestjs-http-envelope.git"
  },
  "bugs": {
    "url": "https://github.com/onury/nestjs-http-envelope/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "nest",
    "envelope",
    "response",
    "interceptor",
    "exception-filter",
    "api",
    "rest",
    "pagination"
  ],
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11 || ^12",
    "@nestjs/core": "^10 || ^11 || ^12",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "biome-config-oy": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
